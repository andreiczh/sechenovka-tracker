# Server-side settings. Do not put this file in public/ or commit a filled copy.
NODE_ENV=production
NODEJS_VERSION=24
DEMO_MODE=true
# Render automatically provides RENDER_EXTERNAL_URL, HOST and PORT.
# With DATABASE_URL, no persistent local disk or DATA_DIR is required.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
# On other hosts set PUBLIC_ORIGIN explicitly. For SQLite also set:
# DATA_DIR=/absolute/persistent/path/outside/code

# Start with off. After setting up an external scheduler, change to external and
# generate CRON_SECRET on the host: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
REMINDER_SCHEDULER=off
# CRON_SECRET=

# Optional real Telegram transport. Keep all three values server-side.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_IDENTITY_SECRET=
TELEGRAM_BOT_USERNAME=sechenov_track_bot

# Optional separate key for the protected teaching clinic (24–256 characters).
# Without an override, a purpose-separated key is derived server-side from the
# existing TELEGRAM_IDENTITY_SECRET. It is never sent to the patient UI.
# CLINICIAN_ACCESS_KEY=

# Optional Groq: server-only, synthetic demo data, on-demand doctor summary.
# Keep an existing key in an ignored .env.groq file locally and Render secrets.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_LIMIT=20
# Alternative: the fixed free model only; no paid model fallback.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
